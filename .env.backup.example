# Dedicated operator process only. Do not load this file into web/render/mail services.
# Initialize and pin an existing encrypted Restic repository separately.
RESTIC_REPOSITORY=s3:https://s3.example.invalid/reelchemy-backups
RESTIC_PASSWORD_FILE=/run/private/backup-password
REELCHEMY_BACKUP_TIMEOUT_MS=900000
# Optional S3-compatible backend credentials, scoped to this repository prefix.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
# Pass the public repository ID, independent authority ID/key fingerprint and
# explicit completed snapshot/retention arguments to npm run backup:encrypted.
# Keep the repository password in a separate recoverable private secret file.
