# No keys needed for mock mode. Credentials stay on the server.
AI_PROVIDER=mock
# Set these only for an OpenAI-compatible API:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# AI_API_KEY=
CHROMIUM_PATH=/usr/bin/chromium
RENDER_CONCURRENCY=2
# Native Claude Messages API: AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=<model available to your account>
# AI_API_KEY=<set securely on the server>

# Live planning also requires the selected model/gateway's current USD prices
# per million tokens (plain decimals, at most six fractional digits).
# REELCHEMY_AI_INPUT_USD_PER_MILLION=
# REELCHEMY_AI_OUTPUT_USD_PER_MILLION=
# Cache read defaults to input price; cache creation defaults to 2x input.
# Set explicit rates if the selected provider's pricing differs.
# REELCHEMY_AI_CACHE_READ_USD_PER_MILLION=
# REELCHEMY_AI_CACHE_WRITE_USD_PER_MILLION=
# Estimated-cost rolling 24-hour allowances; zero pauses live planning.
# REELCHEMY_AI_GLOBAL_USD_PER_DAY=20
# REELCHEMY_AI_STUDIO_USD_PER_DAY=2
# REELCHEMY_AI_CONCURRENT_CALLS=2
# REELCHEMY_AI_CALLS_PER_STUDIO=1
# REELCHEMY_AI_MAX_PAYLOAD_BYTES=131072
# Ledger capacity fails new paid calls closed; no automatic receipt deletion.
# REELCHEMY_AI_LEDGER_MAX_REQUESTS=100000

# Public accounts (mandatory on a production host, independent of AI keys)
# BETTER_AUTH_URL=https://studio.example.com
# BETTER_AUTH_SECRET=<generate a random signing secret, at least 32 characters>
# REELCHEMY_AUTH_DIR=/private/reelchemy-auth
# Production requires a separate account/mail directory outside media/exports.
# Existing combined data must be backed up/restored into new separate roots.
# EMAIL_DELIVERY=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Reelchemy <accounts@example.com>
# Development only: EMAIL_DELIVERY=file writes private .data/mail JSON files.

# Public workspace request windows (positive integer counts, no provider key needed)
# REELCHEMY_WRITES_PER_MINUTE=120
# REELCHEMY_MEDIA_REQUESTS_PER_HOUR=30
# REELCHEMY_PLANS_PER_DAY=60
# REELCHEMY_EXPORT_REQUESTS_PER_DAY=30
# These count request attempts, including validation/provider/queue failures.
# They are not byte quotas, token/dollar budgets, billing or a capacity guarantee.

# Active queued/rendering exports per studio, 1–5; shared queue remains capped at 5.
# REELCHEMY_ACTIVE_EXPORTS_PER_STUDIO=2
# Retained exports and active output reservations, applied to web AND render.
# Logical file bytes; working output may briefly exceed its captured ceiling
# while cancellation closes native processes. This is not a filesystem quota.
# REELCHEMY_EXPORT_RESERVATION_BYTES=536870912
# REELCHEMY_EXPORT_STUDIO_BYTES=2147483648
# REELCHEMY_EXPORT_SERVICE_BYTES=8589934592
# REELCHEMY_EXPORT_STUDIO_COUNT=100
# REELCHEMY_EXPORT_SERVICE_COUNT=2000
# Existing jobs require a coordinated backup, stopped writers and explicit
# npm run exports:recount -- --data /studio-data --artifacts /exports
# before new renders start. Existing films/downloads remain readable.
# Export reports/timelines/activity are a separate logical JSON/receipt budget.
# New jobs capture 4 MiB for details + 4 MiB for timeline + 4 KiB for receipts.
# Retire reviewed details through Manage export activity after file cleanup;
# small source-reference/replay records remain. No automatic eviction occurs.
# REELCHEMY_JOB_STUDIO_BYTES=268435456
# REELCHEMY_JOB_SERVICE_BYTES=4294967296
# REELCHEMY_JOB_STUDIO_COUNT=500
# REELCHEMY_JOB_SERVICE_COUNT=20000
# REELCHEMY_JOB_STUDIO_RETIRED=5000
# REELCHEMY_JOB_SERVICE_RETIRED=80000
# Shared full + retired limits cannot exceed 100,000 indexed jobs. Existing
# overages remain readable/shrinkable after a coordinated stopped-writer upgrade.

# Retained normalized media per private studio, including projects in Trash.
# Existing over-limit media stays readable; new uploads/imports must fit.
# REELCHEMY_MEDIA_STORAGE_BYTES=536870912
# Whole byte count, 1 MiB–1 TiB. Export/cache/backups have separate retention needs.

# Shared media admission (same values on web and ingest services).
# In native development, export relevant media settings to the worker shell too;
# the codec worker does not load a web .env.local containing account/API secrets.
# REELCHEMY_MEDIA_INPUT_SLOTS=4
# REELCHEMY_MEDIA_INPUTS_PER_STUDIO=1
# REELCHEMY_MEDIA_ANALYSIS_SLOTS=16
# REELCHEMY_MEDIA_ANALYSES_PER_STUDIO=4
# REELCHEMY_MEDIA_RAW_BYTES=268435456
# REELCHEMY_WAVEFORMS_PER_HOUR=120
# Raw reservations remain charged until temporary files are physically cleaned.

# Rebuildable scene-cache retention, render service only. Whole byte/count values.
# Studio ceiling must not exceed the shared ceiling. Successful reuse refreshes LRU.
# REELCHEMY_SCENE_CACHE_BYTES=1073741824
# REELCHEMY_SCENE_CACHE_BYTES_PER_STUDIO=268435456
# REELCHEMY_SCENE_CACHE_ENTRIES=5000
# REELCHEMY_SCENE_CACHE_DAYS=7
# Originals, completed exports, histories and backups have separate retention.

# Retained project JSON admission: logical UTF-8 bytes, including saved history,
# directions, current film and asset metadata. Same values on web and ingest.
# These do not include binary media, jobs/exports, SQLite/WAL allocation or backups.
# REELCHEMY_PROJECT_DATA_BYTES=33554432
# REELCHEMY_STUDIO_DATA_BYTES=268435456
# REELCHEMY_SERVICE_DATA_BYTES=4294967296
# Project <= studio <= service; positive whole bytes within documented bounds.
# Project counts include Trash; service counts include unassigned legacy projects.
# REELCHEMY_STUDIO_PROJECTS=500
# REELCHEMY_SERVICE_PROJECTS=20000
# REELCHEMY_PROJECT_VERSIONS=10000
# REELCHEMY_PROJECT_MESSAGES=10000
# Version bounds: 2..10000; direction bounds: 3..10000, leaving room after cleanup.
# Existing overages stay readable; reductions are allowed. Nothing is auto-pruned.

# Shared retained normalized source files (web and ingest must agree).
# Includes current/history/job references and previously indexed legacy sources.
# REELCHEMY_MEDIA_SHARED_STORAGE_BYTES=8589934592
# 1 MiB–4 TiB, at least the per-studio media allowance; zero is invalid.
# New work captures this ceiling and final attachment honors the stricter of
# admitted/current limits. Originals are not automatically evicted.

# Private account-mail queue; shared between web and mail consumer.
# Logical UTF-8 envelope budget includes retry/lease headroom. No SMTP at request time.
# REELCHEMY_MAIL_PENDING_COUNT=1000
# REELCHEMY_MAIL_PENDING_BYTES=16777216

# Production privacy authority: initialize explicitly on independently managed
# storage with privacy:init. Restore studio snapshots against the CURRENT vault.
# Never automatically initialize/recreate a missing vault on application startup.
# REELCHEMY_PRIVACY_DIR=/private/reelchemy-privacy
# REELCHEMY_PRIVACY_ID=<initialized vault UUID>
# REELCHEMY_PRIVACY_KEY_FINGERPRINT=<initialized key fingerprint>
# Compose bind source (must already exist and be writable by container UID 1000):
# REELCHEMY_PRIVACY_DIR_ON_HOST=/srv/reelchemy-independent-privacy
