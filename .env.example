# No keys needed for mock mode. Credentials stay on the server.
AI_PROVIDER=mock
# Set these only for an OpenAI-compatible API:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# AI_API_KEY=
CHROMIUM_PATH=/usr/bin/chromium
RENDER_CONCURRENCY=2
# Native Claude Messages API: AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=<model available to your account>
# AI_API_KEY=<set securely on the server>

# Public accounts (mandatory on a production host, independent of AI keys)
# BETTER_AUTH_URL=https://studio.example.com
# BETTER_AUTH_SECRET=<generate a random signing secret, at least 32 characters>
# EMAIL_DELIVERY=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Reelchemy <accounts@example.com>
# Development only: EMAIL_DELIVERY=file writes private .data/mail JSON files.

# Public workspace request windows (positive integer counts, no provider key needed)
# REELCHEMY_WRITES_PER_MINUTE=120
# REELCHEMY_MEDIA_REQUESTS_PER_HOUR=30
# REELCHEMY_PLANS_PER_DAY=60
# REELCHEMY_EXPORT_REQUESTS_PER_DAY=30
# These count request attempts, including validation/provider/queue failures.
# They are not byte quotas, token/dollar budgets, billing or a capacity guarantee.

# Active queued/rendering exports per studio, 1–5; shared queue remains capped at 5.
# REELCHEMY_ACTIVE_EXPORTS_PER_STUDIO=2

# Retained normalized media per private studio, including projects in Trash.
# Existing over-limit media stays readable; new uploads/imports must fit.
# REELCHEMY_MEDIA_STORAGE_BYTES=536870912
# Whole byte count, 1 MiB–1 TiB. Export/cache/backups have separate retention needs.
