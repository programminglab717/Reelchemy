{
  "name": "reelchemy",
  "version": "0.33.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && tsx scripts/check-build.ts && tsx scripts/check-private-traces.ts && tsx scripts/check-render-bundle.ts",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-unit.ts",
    "render:sample": "tsx scripts/render-sample.ts",
    "test:e2e": "playwright test",
    "worker": "tsx scripts/worker-entrypoint.ts",
    "ingest:worker": "tsx scripts/ingest-entrypoint.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx scripts/seed.ts",
    "auth:migrate": "tsx scripts/auth-migrate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "workspace:claim": "tsx scripts/claim-legacy.ts",
    "mail:worker": "tsx scripts/mail-worker.ts",
    "test:isolated": "tsx scripts/test-isolated.ts",
    "backup": "tsx scripts/backup.ts",
    "test:production": "tsx scripts/test-isolated.ts --production",
    "test:runtime": "tsx scripts/check-runtime.ts",
    "container:build": "tsx scripts/container-build.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "better-auth": "1.7.14",
    "better-sqlite3": "^12.0.0",
    "fflate": "^0.8.3",
    "next": "^16.0.0",
    "nodemailer": "10.2.1",
    "playwright-core": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.539",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "zod": "$zod"
  }
}
